{
  "name": "myos-markdown",
  "version": "1.1.1",
  "description": "A local-first Markdown editor and productivity system for macOS and Linux",
  "main": "dist-electron/main.js",
  "desktopName": "myos.desktop",
  "homepage": "https://github.com/agent33894/myOS",
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist dist-electron release",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron shared --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src electron shared --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run clean && vite build && node scripts/package-macos.mjs --arch=arm64",
    "build:installer": "npm run clean && vite build && node scripts/package-macos.mjs --arch=arm64 --installer",
    "build:linux": "npm run clean && vite build && node scripts/package-linux.mjs --arch=x64",
    "build:local": "npm run clean && vite build && node scripts/package-linux.mjs --arch=x64 --dir",
    "build:arch": "npm run build:linux && node scripts/package-arch.mjs",
    "install:local": "npm run build:local && node scripts/install-local.mjs",
    "install:local:built": "node scripts/install-local.mjs",
    "smoke:linux": "node scripts/smoke-linux.mjs",
    "preview": "vite preview",
    "audit:design-tokens": "node scripts/audit-design-tokens.js",
    "audit:design-tokens:fix": "node scripts/audit-design-tokens.js --fix",
    "design-system:export": "vite-node scripts/export-design-system.ts",
    "design-system:check": "vite-node scripts/export-design-system.ts --check",
    "audit:imports": "node scripts/audit-import-graph.mjs",
    "audit:ipc": "node scripts/audit-ipc-surface.mjs",
    "audit:selectors": "node scripts/audit-selector-surface.mjs",
    "audit:exports": "knip --include exports,types --no-progress",
    "audit:dead-code": "knip --include files,dependencies,unlisted --no-progress",
    "audit:docs": "node scripts/audit-doc-links.mjs"
  },
  "keywords": [
    "knowledge-management",
    "electron",
    "react",
    "typescript"
  ],
  "author": "myOS contributors",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/js-yaml": "^3.12.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.16",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "knip": "^5.88.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block": "^3.14.0",
    "@tiptap/extension-image": "^3.14.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-list": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/extension-table": "^3.14.0",
    "@tiptap/extension-table-cell": "^3.14.0",
    "@tiptap/extension-table-header": "^3.14.0",
    "@tiptap/extension-table-row": "^3.14.0",
    "@tiptap/extension-text-align": "^3.14.0",
    "@tiptap/extension-typography": "^3.14.0",
    "@tiptap/markdown": "^3.14.0",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "js-yaml": "^3.15.1",
    "lucide-react": "^0.303.0",
    "mermaid": "^11.17.1",
    "non.geist": "^2.0.1",
    "react": "^18.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^18.2.0",
    "react-focus-lock": "^2.13.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.6.0",
    "shiki": "^3.20.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^4.4.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
