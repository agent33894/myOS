{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "electron/main.ts",
    "electron/preload.ts",
    "public/theme-init.js",
    "scripts/*.{js,mjs,ts}",
    "src/ui/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx}",
    "electron/**/*.{ts,tsx}",
    "shared/**/*.{ts,tsx}",
    "scripts/**/*.{ts,js,mjs}"
  ],
  "ignoreDependencies": [
    "electron-builder"
  ],
  "ignoreExportsUsedInFile": true
}
