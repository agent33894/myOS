{
  "appId": "com.myos.next",
  "productName": "myOS Next",
  "artifactName": "myOS-Next-${version}-${arch}.${ext}",
  "icon": "build/icon.png",
  "protocols": {
    "name": "myOS Next link",
    "schemes": [
      "myos-next"
    ]
  },
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!**/node_modules/**",
    "!**/*.map"
  ],
  "electronLanguages": [
    "en"
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "target": [
      "dmg",
      "zip"
    ],
    "extendInfo": {
      "CFBundleLocalizations": [
        "en"
      ]
    }
  },
  "linux": {
    "target": [
      "AppImage",
      "tar.gz"
    ],
    "category": "Office",
    "icon": "build/icon.png",
    "executableName": "myos-next",
    "syncDesktopName": true,
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "desktop": {
      "entry": {
        "Name": "myOS Next",
        "Comment": "A quiet editor for a folder of Markdown files",
        "Categories": "Office;TextEditor;",
        "MimeType": "x-scheme-handler/myos-next;",
        "StartupWMClass": "myos-next"
      },
      "desktopActions": {
        "capture": {
          "Name": "Capture",
          "Exec": "myos-next --capture"
        }
      }
    }
  }
}
