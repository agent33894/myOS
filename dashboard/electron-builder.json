{
  "appId": "com.myos.markdown",
  "productName": "myOS",
  "artifactName": "myOS-${version}-${arch}.${ext}",
  "icon": "build/icon.png",
  "protocols": {
    "name": "myOS link",
    "schemes": ["myos"]
  },
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!**/node_modules/**",
    "!**/*.map"
  ],
  "electronLanguages": ["en"],
  "mac": {
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "target": ["dmg", "zip"],
    "extendInfo": {
      "CFBundleLocalizations": ["en"]
    }
  },
  "linux": {
    "target": ["AppImage", "tar.gz"],
    "category": "Office",
    "icon": "build/icon.png",
    "executableName": "myos",
    "desktop": {
      "entry": {
        "Name": "myOS",
        "Comment": "Local Markdown workspace",
        "Categories": "Office;Productivity;",
        "MimeType": "x-scheme-handler/myos;",
        "StartupWMClass": "myOS"
      }
    }
  }
}
